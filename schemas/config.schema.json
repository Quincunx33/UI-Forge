{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-forge.invalid/schemas/config.schema.json",
  "title": "UI-Forge Configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "baseUrl": {
      "type": "string",
      "format": "uri"
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "viewports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "width",
          "height"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "width": {
            "type": "integer",
            "minimum": 240,
            "maximum": 7680
          },
          "height": {
            "type": "integer",
            "minimum": 320,
            "maximum": 4320
          },
          "deviceScaleFactor": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 4
          }
        }
      },
      "default": [
        {
          "name": "mobile",
          "width": 390,
          "height": 844
        },
        {
          "name": "tablet",
          "width": 768,
          "height": 1024
        },
        {
          "name": "desktop",
          "width": 1440,
          "height": 900
        }
      ]
    },
    "mode": {
      "enum": [
        "detect",
        "design-review",
        "repair"
      ],
      "default": "detect"
    },
    "outputDir": {
      "type": "string",
      "default": ".ui-forge"
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": {
          "enum": [
            "chromium",
            "firefox",
            "webkit"
          ]
        },
        "headless": {
          "type": "boolean",
          "default": true
        },
        "navigationTimeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        }
      }
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxAttemptsPerFinding": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "default": 2
        },
        "requireApprovalForSensitiveFiles": {
          "type": "boolean",
          "default": true
        },
        "allowDependencyChanges": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "ignore": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "allowRemote": {
      "type": "boolean",
      "default": false,
      "description": "Explicitly allow a non-loopback audit target. Use only for systems you own or are authorized to test."
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "maxRoutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 20
        }
      },
      "default": {
        "enabled": false,
        "maxRoutes": 20
      },
      "description": "Opt-in same-origin anchor crawl. No controls are clicked or forms submitted; capped at 50 additional same-origin routes; explicitly configured routes are always retained."
    },
    "interactions": {
      "type": "array",
      "default": [],
      "description": "Opt-in clicks on explicitly marked safe test buttons only.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "testId",
          "route"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "testId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "route": {
            "type": "string",
            "pattern": "^/(?!/)"
          },
          "expectedText": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    }
  }
}
