{
  "schema_version": "1.0",
  "id": "ui-forge",
  "name": "UI-Forge",
  "version": "0.1.0",
  "description": "A portable coding-agent plugin for evidence-based UI quality audits, visual design review, and controlled frontend repair.",
  "license": "UNLICENSED",
  "capabilities": {
    "detection": true,
    "design_review": true,
    "repair": true,
    "browser_automation": "adapter-required"
  },
  "skills": [
    "skills/ui-detect/SKILL.md",
    "skills/ui-repair/SKILL.md",
    "skills/ui-design-review/SKILL.md"
  ],
  "schemas": {
    "config": "schemas/config.schema.json",
    "report": "schemas/report.schema.json"
  },
  "safety": {
    "default_mode": "detect",
    "detection_must_not_modify_files": true,
    "repair_requires_explicit_invocation": true,
    "max_repair_attempts_default": 2,
    "sensitive_flows_require_approval": true
  }
}
