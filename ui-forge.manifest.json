{
  "schema_version": "1.0",
  "id": "ui-forge",
  "name": "UI-Forge",
  "version": "0.4.0",
  "description": "A portable coding-agent plugin for evidence-based UI quality audits, axe-core accessibility scans, visual design review, and controlled frontend repair.",
  "license": "UNLICENSED",
  "capabilities": {
    "detection": "agent-skill-and-cli",
    "design_review": true,
    "repair": true,
    "browser_automation": "optional-playwright-runtime",
    "motion_audit": "initial-css-animation-smoke-check",
    "accessibility_audit": "axe-core-wcag2a-wcag2aa-wcag21a-wcag21aa-best-practice-plus-smoke-checks",
    "target_policy": "loopback-default-remote-opt-in",
    "skill_installer": [
      "codex",
      ".claude",
      "cursor"
    ],
    "visual_regression": "png-baseline-pixel-diff",
    "functional_testing": "opt-in-safe-test-buttons"
  },
  "skills": [
    "skills/ui-detect/SKILL.md",
    "skills/ui-repair/SKILL.md",
    "skills/ui-design-review/SKILL.md"
  ],
  "schemas": {
    "config": "schemas/config.schema.json",
    "report": "schemas/report.schema.json"
  },
  "safety": {
    "default_mode": "detect",
    "detection_must_not_modify_files": true,
    "repair_requires_explicit_invocation": true,
    "max_repair_attempts_default": 2,
    "sensitive_flows_require_approval": true
  },
  "cli": {
    "entrypoint": "bin/ui-forge.js",
    "commands": [
      "detect",
      "handoff",
      "review",
      "apply"
    ]
  }
}
